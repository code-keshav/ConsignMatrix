@functions {
    bool IsActive(string area, string controller, string action)
    {
        var currentArea = ViewContext.RouteData.Values["area"]?.ToString() ?? "";
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

        if (string.IsNullOrEmpty(currentAction)) currentAction = "Index";
        if (string.IsNullOrEmpty(action)) action = "Index";

        return string.Equals(currentArea, area, StringComparison.OrdinalIgnoreCase)
            && string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase)
            && string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase);
    }

    string ActiveClass(string area, string controller, string action)
    {
        return IsActive(area, controller, action) ? "active" : "";
    }

    string MenuOpenClass(params (string area, string controller, string action)[] items)
    {
        foreach (var item in items)
        {
            if (IsActive(item.area, item.controller, item.action))
                return "menu-open";
        }
        return "";
    }
}

