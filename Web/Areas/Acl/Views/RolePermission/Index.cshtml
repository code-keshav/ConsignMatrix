@model Web.Areas.Acl.ViewModels.RolePermissionUpdateVm

@{
ViewData["Title"] = "Role Permission";
Layout = "_Layout";
}

<h2>@ViewData["Title"]</h2>

<form method="get" asp-action="Index" asp-controller="RolePermission">
    <div class="row align-items-end">
        <div class="col-2">
            <label class="form-label">Roles</label>
            <select class="form-select" asp-for="RoleId" asp-items="Model.RoleOptions">
                <option value="">Select Role</option>
            </select>
        </div>
        <div class="col-1">
            <button type="submit" class="btn btn-primary">Go</button>
        </div>
    </div>
</form>

@if (Model.RoleId > 0)
{
<form method="post" asp-action="SavePermissions" asp-controller="RolePermission" id="permissionForm">
    <input type="hidden" asp-for="RoleId" />
    
    <div class="mt-4 d-flex flex-column gap-2 w-100 justify-content-center">
        @*<div class="row justify-content-center mt-3">
            <div class="col-6">
            </div>
        </div>*@
        <div class="card">
            <div class="card-header">
                <span class="card-title">Assign Permission for @Model.RoleName</span>
            </div>
            <div class="card-body">
                <div id="permissions-tree" style="height: 500px; overflow-y: auto;"></div>
            </div>
            <div class="card-footer">
                <div class="d-flex justify-content-center">
                    <button type="submit" class="btn btn-primary" id="saveButton">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                             stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icon-tabler-progress-check">
                            <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                            <path d="M10 20.777a8.942 8.942 0 0 1 -2.48 -.969"/>
                            <path d="M14 3.223a9.003 9.003 0 0 1 0 17.554"/>
                            <path d="M4.579 17.093a8.961 8.961 0 0 1 -1.227 -2.592"/>
                            <path d="M3.124 10.5c.16 -.95 .468 -1.85 .9 -2.675l.169 -.305"/>
                            <path d="M6.907 4.579a8.954 8.954 0 0 1 3.093 -1.356"/>
                            <path d="M9 12l2 2l4 -4"/>
                        </svg>
                        Save
                    </button>
                </div>
            </div>
        </div>
        
    </div>

    
</form>
}

@section Scripts {
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/jstree/3.3.12/themes/default/style.min.css" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/jstree/3.3.12/jstree.min.js"></script>

<script>
    $(function () {
        const treeData = [];
        const initiallySelected = [];

        @foreach (var perm in Model.AllPermissions)
        {
            perm.IsSelected = Model.Permissions.Any(x => x.Equals(perm.Url));
        <text>
        var parent = {
            text: "@perm.DisplayName",
            id: "@perm.Url",
            state: { selected: @perm.IsSelected.ToString().ToLower() },
            data: { url: "@perm.Url" },
            children: []
        };
        @if (perm.IsSelected)
        {
        <text>initiallySelected.push("@perm.Url");</text>
        }

        @foreach (var child in perm.Children)
        {
            child.IsSelected = Model.Permissions.Any(x => x.Equals(child.Url));
        <text>
        parent.children.push({
            text: "@child.DisplayName",
            id: "@child.Url",
            state: { selected: @child.IsSelected.ToString().ToLower() },
            data: { url: "@child.Url" }
        });
        @if (child.IsSelected)
        {
        <text>initiallySelected.push("@child.Url");</text>
        }
        </text>
        }

        treeData.push(parent);
        </text>
        }

        const $tree = $('#permissions-tree');

        $tree.jstree({
            core: {
                data: treeData,
                themes: { responsive: false, icons: false },
                check_callback: true
            },
            checkbox: {
                keep_selected_style: false,
                three_state: true,
                cascade: 'down'
            },
            plugins: ['checkbox']
        }).on('ready.jstree', function () {
            $tree.jstree('open_all');
            initiallySelected.forEach(id => $tree.jstree('select_node', id));
        });

        $('#permissionForm').on('submit', function (e) {
            e.preventDefault();

            const selected = $tree.jstree('get_selected', true)
                .map(n => n.data);

            // Remove existing inputs
            $(this).find('input[name^="selectedPermissions["]').remove();

            // Add inputs dynamically
            let idx = 0;
            selected.forEach((item) => {
                if(item.url){
                    $('<input>').attr({
                        type: 'hidden',
                        name: `selectedPermissions[${idx}]`,
                        value: item.url
                    }).appendTo('#permissionForm');
                    idx++;
                }
            });

            this.submit();
        });
    });
</script>
}
