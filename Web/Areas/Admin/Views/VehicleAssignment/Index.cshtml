@model Web.Areas.Admin.ViewModels.VehicleAssignmentIndexVm

@{
    ViewData["Title"] = "Vehicle Assignments";
    Layout = "_Layout";
}

<div class="">
    <div class="mt-2">
        <div class="d-flex justify-content-between align-items-end mb-3">
            <span class="header_text">Vehicle Assignments</span>
            <div class="d-flex gap-2">
                <a asp-area="Admin" asp-controller="VehicleAssignment" asp-action="Create" class="btn btn-primary btn-sm">
                    Create
                </a>
            </div>
        </div>

        <!-- Filter Section -->
        <div class="card mb-3">
            <div class="card-header">
                <h6 class="mb-0">Filter Assignments</h6>
            </div>
            <div class="card-body">
                <form asp-area="Admin" asp-controller="VehicleAssignment" asp-action="Index" method="get">
                    <div class="row g-3">
                        <div class="col-md-3">
                            <label asp-for="VehicleId" class="form-label">Vehicle</label>
                            <select asp-for="VehicleId" class="form-control select2" asp-items="@Model.VehicleSelectList">
                                <option value="">All Vehicles</option>
                            </select>
                        </div>

                        <div class="col-md-2">
                            <label asp-for="AssignmentType" class="form-label">Type</label>
                            <select asp-for="AssignmentType" class="form-control" asp-items="@Model.AssignmentTypeSelectList">
                                <option value="">All Types</option>
                            </select>
                        </div>

                        <div class="col-md-2">
                            <label asp-for="IsActive" class="form-label">Status</label>
                            <select asp-for="IsActive" class="form-control" asp-items="@Model.IsActiveSelectList">
                                <option value="">All</option>
                            </select>
                        </div>

                        <div class="col-md-3 d-flex align-items-end">
                            <button type="submit" class="btn btn-primary me-2">
                                <i class="fa fa-search"></i> Search
                            </button>
                            <a asp-area="Admin" asp-controller="VehicleAssignment" asp-action="Index" class="btn btn-secondary">
                                <i class="fa fa-redo"></i> Reset
                            </a>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <!-- Results Summary -->
        <div class="mb-2">
            <p class="text-muted">
                Showing @((Model.CurrentPage - 1) * Model.PageSize + 1) to @Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalCount) of @Model.TotalCount assignments
            </p>
        </div>
    </div>

    <!-- Assignments Table -->
    <div class="table-responsive">
        <table class="table table_bold table-bordered table-hover" id="datatable">
            <thead class="table-light">
            <tr>
                <th>SN</th>
                <th>Vehicle</th>
                <th>Employee</th>
                <th>Code</th>
                <th>Assignment Type</th>
                <th>Assigned From</th>
                <th>Assigned To</th>
                <th>Status</th>
                <th>Action</th>
            </tr>
            </thead>
            <tbody>
            @if (Model.Assignments.Any())
            {
                var serialNumber = (Model.CurrentPage - 1) * Model.PageSize;
                foreach (var item in Model.Assignments)
                {
                    serialNumber++;
                    <tr>
                        <td>@serialNumber</td>
                        <td>
                            <a asp-controller="VehicleAssignment" asp-action="Update" asp-route-vehicleId="@item.VehicleId">
                                @item.VehicleNumber
                            </a>
                        </td>
                        <td>@item.EmployeeName</td>
                        <td>@item.EmployeeCode</td>
                        <td>
                            @switch (item.AssignmentType)
                            {
                                case Base.Enum.VehicleAssignmentType.Driver:
                                    <span class="badge bg-primary">Driver</span>
                                    break;
                                case Base.Enum.VehicleAssignmentType.SupportingWorker:
                                    <span class="badge bg-info">Supporting Worker</span>
                                    break;
                                case Base.Enum.VehicleAssignmentType.Helper:
                                    <span class="badge bg-secondary">Helper</span>
                                    break;
                            }
                        </td>
                        <td>@item.AssignedFrom.ToString("yyyy-MM-dd")</td>
                        <td>@(item.AssignedTo?.ToString("yyyy-MM-dd") ?? "Open")</td>
                        <td>
                            @if (item.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-warning">Inactive</span>
                            }
                        </td>
                        <td>
                            @if (item.IsActive)
                            {
                                <a class="btn btn-sm btn-warning req-confirm" asp-action="Deactivate" asp-route-id="@item.Id">Deactivate</a>
                            }
                            <a class="btn btn-sm btn-danger req-confirm" asp-action="Remove" asp-route-id="@item.Id">Delete</a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="9" class="text-center">No assignments found</td>
                </tr>
            }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <nav aria-label="Page navigation">
            <ul class="pagination justify-content-center">
                <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                    <a class="page-link" href="?page=@(Model.CurrentPage - 1)&vehicleId=@Model.VehicleId&assignmentType=@Model.AssignmentType&isActive=@Model.IsActive">Previous</a>
                </li>

                @for (var i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                        <a class="page-link" href="?page=@i&vehicleId=@Model.VehicleId&assignmentType=@Model.AssignmentType&isActive=@Model.IsActive">@i</a>
                    </li>
                }

                <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" href="?page=@(Model.CurrentPage + 1)&vehicleId=@Model.VehicleId&assignmentType=@Model.AssignmentType&isActive=@Model.IsActive">Next</a>
                </li>
            </ul>
        </nav>
    }
</div>

@section Scripts{
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            $('.select2').select2({
                placeholder: "Select Vehicle",
                allowClear: true,
                width: '100%'
            });
        });
    </script>
}
