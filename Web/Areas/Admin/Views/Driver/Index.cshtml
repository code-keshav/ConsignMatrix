@model Web.Areas.Admin.ViewModels.DriverIndexVm

@{
    ViewData["Title"] = "Drivers";
    Layout = "_Layout";
}

<div class="">
    <div class="mt-2">
        <div class="d-flex justify-content-between align-items-end mb-3">
            <span class="header_text">Drivers</span>
        </div>

        <!-- Filter Section -->
        <div class="card mb-3">
            <div class="card-header">
                <h6 class="mb-0">Filter Drivers</h6>
            </div>
            <div class="card-body">
                <form asp-area="Admin" asp-controller="Driver" asp-action="Index" method="get">
                    <div class="row g-3">
                        <div class="col-md-3">
                            <label asp-for="SearchTerm" class="form-label">Search</label>
                            <input asp-for="SearchTerm" class="form-control" placeholder="Name, Code, Phone, or License"/>
                        </div>

                        @if (Model.IsMainBranchUser)
                        {
                            <div class="col-md-2">
                                <label asp-for="BranchId" class="form-label">Branch</label>
                                <select asp-for="BranchId" class="form-control select2" asp-items="@Model.BranchSelectList">
                                    <option value="">All Branches</option>
                                </select>
                            </div>
                        }

                        <div class="col-md-2">
                            <div class="form-check mt-4">
                                <input type="checkbox" asp-for="LicenseExpiringSoon" class="form-check-input"/>
                                <label class="form-check-label" asp-for="LicenseExpiringSoon">Expiring Soon</label>
                            </div>
                        </div>

                        <div class="col-md-3 d-flex align-items-end">
                            <button type="submit" class="btn btn-primary me-2">
                                <i class="fa fa-search"></i> Search
                            </button>
                            <a asp-area="Admin" asp-controller="Driver" asp-action="Index" class="btn btn-secondary">
                                <i class="fa fa-redo"></i> Reset
                            </a>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <!-- Results Summary -->
        <div class="mb-2">
            <p class="text-muted">
                Showing @((Model.CurrentPage - 1) * Model.PageSize + 1) to @Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalCount) of @Model.TotalCount drivers
            </p>
        </div>
    </div>

    <!-- Drivers Table -->
    <div class="table-responsive">
        <table class="table table_bold table-bordered table-hover">
            <thead class="table-light">
            <tr>
                <th>SN</th>
                <th>Employee Code</th>
                <th>Name</th>
                <th>Branch</th>
                <th>Phone</th>
                <th>License Number</th>
                <th>License Expiry</th>
                <th>Action</th>
            </tr>
            </thead>
            <tbody>
            @if (Model.Drivers.Any())
            {
                var serialNumber = (Model.CurrentPage - 1) * Model.PageSize;
                foreach (var item in Model.Drivers)
                {
                    serialNumber++;
                    var licenseDaysLeft = (item.LicenseExpiry - DateTime.UtcNow).TotalDays;
                    <tr>
                        <td>@serialNumber</td>
                        <td>@item.EmployeeCode</td>
                        <td>@item.EmployeeName</td>
                        <td>@item.BranchName</td>
                        <td>@item.Phone</td>
                        <td>@item.LicenseNumber</td>
                        <td>
                            @if (licenseDaysLeft <= 0)
                            {
                                <span class="badge bg-danger">@item.LicenseExpiry.ToString("yyyy-MM-dd") (Expired)</span>
                            }
                            else if (licenseDaysLeft <= 30)
                            {
                                <span class="badge bg-warning">@item.LicenseExpiry.ToString("yyyy-MM-dd")</span>
                            }
                            else
                            {
                                <span>@item.LicenseExpiry.ToString("yyyy-MM-dd")</span>
                            }
                        </td>
                        <td>
                            <a class="btn btn-sm btn-info" asp-action="Update" asp-route-id="@item.Id">Edit</a>
                            <a class="btn btn-sm btn-secondary" asp-area="Admin" asp-controller="Employee" asp-action="Update" asp-route-id="@item.EmployeeId">
                                <i class="fa fa-user"></i> Employee
                            </a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="8" class="text-center">No drivers found</td>
                </tr>
            }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <nav aria-label="Page navigation">
            <ul class="pagination justify-content-center">
                <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                    <a class="page-link" href="?page=@(Model.CurrentPage - 1)&searchTerm=@Model.SearchTerm&branchId=@Model.BranchId&licenseExpiringSoon=@Model.LicenseExpiringSoon">Previous</a>
                </li>

                @for (var i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                        <a class="page-link" href="?page=@i&searchTerm=@Model.SearchTerm&branchId=@Model.BranchId&licenseExpiringSoon=@Model.LicenseExpiringSoon">@i</a>
                    </li>
                }

                <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" href="?page=@(Model.CurrentPage + 1)&searchTerm=@Model.SearchTerm&branchId=@Model.BranchId&licenseExpiringSoon=@Model.LicenseExpiringSoon">Next</a>
                </li>
            </ul>
        </nav>
    }
</div>

@section Scripts{
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            @if (Model.IsMainBranchUser)
            {
                <text>
                    $('.select2').select2({
                        placeholder: "Select Branch",
                        allowClear: true,
                        width: '100%'
                    });
                </text>
            }
        });
    </script>
}
