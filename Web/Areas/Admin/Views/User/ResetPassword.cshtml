@model Web.Areas.Admin.Requests.UserResetPasswordVm

@{
    ViewBag.Title = "Reset Password";
}


<form method="post" asp-action="ResetPassword" asp-controller="User" asp-area="Admin">
    <div class="card col-5">
        <h3 class="card-header">Reset Password User</h3>
        <div class="card-body">
            <div class="row w-full">
                <div class="d-flex flex-column gap-2">
                    <div class="field" hidden>
                        <div class="form-group">
                            <label class="form-label required" asp-for="Id"></label>
                            <input type="text" asp-for="Id" class="form-control" required/>
                            <span asp-validation-for="Id" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label class="form-label required" asp-for="Name"> Name </label>
                            <input type="text" asp-for="Name" name="name" class="form-control" disabled/>
                        </div>
                    </div>
                    <div class="field">
                        <div class="form-group">
                            <label class="form-label required" asp-for="NewPassword">New Password</label>
                            <input type="text" asp-for="NewPassword" class="form-control" required/>
                            <span asp-validation-for="NewPassword" class="text-danger"></span>
                        </div>
                    </div>

                </div>
            </div>
        </div>
        <div class="card-footer">
            <button type="submit" class="btn btn btn-primary">Update</button>
            <a asp-action="Index" class="btn btn-ghost-muted">Discard</a>
        </div>
    </div>

</form>
