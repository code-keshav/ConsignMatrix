@model Web.Areas.Admin.ViewModels.BranchImportVm

@{
    ViewBag.Title = "Import Branches";
}

<div class="container-xl">
    <div class="card col-8">
        <h3 class="card-header">Import Branches from Excel</h3>

        <form method="post" asp-action="Import" enctype="multipart/form-data">
            <div class="card-body">
                <div class="alert alert-info">
                    <h4>Instructions:</h4>
                    <ul class="mb-3">
                        <li>Download the sample Excel template below</li>
                        <li>Fill in the branch details (Name, Code, Address, ContactNo, Email)</li>
                        <li><strong>Required fields:</strong> Name, Code, Address, ContactNo</li>
                        <li><strong>Optional field:</strong> Email</li>
                        <li>Code must be unique across all branches</li>
                        <li>Email must be unique if provided</li>
                        <li>Upload the completed Excel file</li>
                    </ul>
                    <a asp-action="DownloadSample" class="btn btn-sm btn-primary">
                        <i class="fa fa-download me-1"></i> Download Sample Template
                    </a>
                </div>

                <div class="form-group mt-3">
                    <label class="form-label required">Excel File (.xlsx)</label>
                    <input type="file" asp-for="File" class="form-control" accept=".xlsx" required />
                    <span asp-validation-for="File" class="text-danger"></span>
                    <small class="form-hint">Maximum file size: 10MB</small>
                </div>
            </div>

            <div class="card-footer">
                <button type="submit" class="btn btn-primary">
                    <i class="fa fa-upload me-1"></i> Upload and Import
                </button>
                <a asp-action="Report" class="btn btn-ghost-muted">Cancel</a>
            </div>
        </form>
    </div>
</div>
