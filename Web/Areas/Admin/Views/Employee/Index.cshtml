@model Web.Areas.Admin.ViewModels.EmployeeIndexVm

@{
    ViewData["Title"] = "Employees";
    Layout = "_Layout";
}

<div class="">
    <div class="mt-2">
        <div class="d-flex justify-content-between align-items-end mb-3">
            <span class="header_text">Employees</span>
            <div class="d-flex gap-2">
                <a asp-area="Admin" asp-controller="Employee" asp-action="Create" class="btn btn-primary btn-sm">
                    Create
                </a>
            </div>
        </div>

        <!-- Filter Section -->
        <div class="card mb-3">
            <div class="card-header">
                <h6 class="mb-0">Filter Employees</h6>
            </div>
            <div class="card-body">
                <form asp-area="Admin" asp-controller="Employee" asp-action="Index" method="get">
                    <div class="row g-3">
                        <div class="col-md-3">
                            <label asp-for="SearchTerm" class="form-label">Search</label>
                            <input asp-for="SearchTerm" class="form-control" placeholder="Name, Code, Phone, or Email"/>
                        </div>

                        @if (Model.IsMainBranchUser)
                        {
                            <div class="col-md-2">
                                <label asp-for="BranchId" class="form-label">Branch</label>
                                <select asp-for="BranchId" class="form-control select2" asp-items="@Model.BranchSelectList">
                                    <option value="">All Branches</option>
                                </select>
                            </div>
                        }

                        <div class="col-md-2">
                            <label asp-for="EmployeeType" class="form-label">Type</label>
                            <select asp-for="EmployeeType" class="form-control" asp-items="@Model.EmployeeTypeSelectList">
                                <option value="">All Types</option>
                            </select>
                        </div>

                        <div class="col-md-2">
                            <label asp-for="EmployeeStatus" class="form-label">Status</label>
                            <select asp-for="EmployeeStatus" class="form-control" asp-items="@Model.EmployeeStatusSelectList">
                                <option value="">All Statuses</option>
                            </select>
                        </div>

                        <div class="col-md-3 d-flex align-items-end">
                            <button type="submit" class="btn btn-primary me-2">
                                <i class="fa fa-search"></i> Search
                            </button>
                            <a asp-area="Admin" asp-controller="Employee" asp-action="Index" class="btn btn-secondary">
                                <i class="fa fa-redo"></i> Reset
                            </a>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <!-- Results Summary -->
        <div class="mb-2">
            <p class="text-muted">
                Showing @((Model.CurrentPage - 1) * Model.PageSize + 1) to @Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalCount) of @Model.TotalCount employees
            </p>
        </div>
    </div>

    <!-- Employees Table -->
    <div class="table-responsive">
        <table class="table table_bold table-bordered table-hover">
            <thead class="table-light">
            <tr>
                <th>SN</th>
                <th>Code</th>
                <th>Name</th>
                <th>Phone</th>
                <th>Email</th>
                <th>Branch</th>
                <th>Type</th>
                <th>Status</th>
                <th>Login</th>
                <th>Action</th>
            </tr>
            </thead>
            <tbody>
            @if (Model.Employees.Any())
            {
                var serialNumber = (Model.CurrentPage - 1) * Model.PageSize;
                foreach (var item in Model.Employees)
                {
                    serialNumber++;
                    <tr>
                        <td>@serialNumber</td>
                        <td>@item.EmployeeCode</td>
                        <td>@item.Name</td>
                        <td>@item.Phone</td>
                        <td>@item.Email</td>
                        <td>@item.BranchName</td>
                        <td>
                            @switch (item.EmployeeType)
                            {
                                case Base.Enum.EmployeeType.Office:
                                    <span class="badge bg-primary">Office</span>
                                    break;
                                case Base.Enum.EmployeeType.Driver:
                                    <span class="badge bg-info">Driver</span>
                                    break;
                                case Base.Enum.EmployeeType.FieldWorker:
                                    <span class="badge bg-warning">Field Worker</span>
                                    break;
                                case Base.Enum.EmployeeType.Support:
                                    <span class="badge bg-secondary">Support</span>
                                    break;
                            }
                        </td>
                        <td>
                            @switch (item.EmployeeStatus)
                            {
                                case Base.Enum.EmployeeStatus.Active:
                                    <span class="badge bg-success">Active</span>
                                    break;
                                case Base.Enum.EmployeeStatus.OnLeave:
                                    <span class="badge bg-warning">On Leave</span>
                                    break;
                                case Base.Enum.EmployeeStatus.Inactive:
                                    <span class="badge bg-secondary">Inactive</span>
                                    break;
                                case Base.Enum.EmployeeStatus.Terminated:
                                    <span class="badge bg-danger">Terminated</span>
                                    break;
                            }
                        </td>
                        <td>
                            @if (item.HasLogin)
                            {
                                <span class="badge bg-success"><i class="fa fa-check"></i></span>
                            }
                            else
                            {
                                <span class="badge bg-secondary"><i class="fa fa-times"></i></span>
                            }
                        </td>
                        <td>
                            <a class="btn btn-sm btn-info" asp-action="Update" asp-route-id="@item.Id">Edit</a>
                            @if (item.DriverId.HasValue)
                            {
                                <a class="btn btn-sm btn-outline-info" asp-area="Admin" asp-controller="Driver" asp-action="Update" asp-route-id="@item.DriverId">
                                    <i class="fa fa-id-card"></i> Driver
                                </a>
                            }
                            <a class="btn btn-sm btn-danger req-confirm" asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="10" class="text-center">No employees found</td>
                </tr>
            }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <nav aria-label="Page navigation">
            <ul class="pagination justify-content-center">
                <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                    <a class="page-link" href="?page=@(Model.CurrentPage - 1)&searchTerm=@Model.SearchTerm&branchId=@Model.BranchId&employeeType=@Model.EmployeeType&employeeStatus=@Model.EmployeeStatus">Previous</a>
                </li>

                @for (var i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                        <a class="page-link" href="?page=@i&searchTerm=@Model.SearchTerm&branchId=@Model.BranchId&employeeType=@Model.EmployeeType&employeeStatus=@Model.EmployeeStatus">@i</a>
                    </li>
                }

                <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" href="?page=@(Model.CurrentPage + 1)&searchTerm=@Model.SearchTerm&branchId=@Model.BranchId&employeeType=@Model.EmployeeType&employeeStatus=@Model.EmployeeStatus">Next</a>
                </li>
            </ul>
        </nav>
    }
</div>

@section Scripts{
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            @if (Model.IsMainBranchUser)
            {
                <text>
                    $('.select2').select2({
                        placeholder: "Select Branch",
                        allowClear: true,
                        width: '100%'
                    });
                </text>
            }
        });
    </script>
}
