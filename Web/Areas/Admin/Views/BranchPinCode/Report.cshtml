@model System.Collections.Generic.List<Web.Areas.Admin.Responses.BranchPinCodeReportResponse>

@{
    ViewBag.Title = "Pin Code Report";
}

<div class="container-xl">
    <div class="mt-2">
        <div class="d-flex justify-content-between align-items-end mb-1">
            <span class="header_text">Branch Pin Codes</span>
            <div class="d-flex gap-2">
                <a asp-area="Admin" asp-controller="BranchPinCode" asp-action="Create" class="btn btn-primary btn-sm">
                    <i class="fa fa-plus me-1"></i> Create
                </a>
            </div>
        </div>
    </div>

    <div class="mb-3">
        <form method="get" asp-action="Report" class="d-flex gap-2 align-items-center">
            <label class="form-label mb-0">Filter by Branch:</label>
            <select name="branchId" class="form-select" style="max-width: 300px;" onchange="this.form.submit()">
                <option value="">All Branches</option>
                @foreach (var branch in (dynamic)ViewBag.Branches)
                {
                    var selected = ViewBag.BranchId != null && (long)ViewBag.BranchId == (long)branch.Id;
                    <option value="@branch.Id" selected="@selected">@branch.Name</option>
                }
            </select>
        </form>
    </div>

    <table class="table table-responsive table_bold table-bordered">
        <thead>
        <th>SN</th>
        <th>Branch</th>
        <th>Pin Code</th>
        <th>Active</th>
        <th>Action</th>
        </thead>
        <tbody>
        @{
            var count = 0;
            foreach (var item in Model)
            {
                <tr>
                    <td>@(++count)</td>
                    <td>@item.BranchName</td>
                    <td>@item.PinCode</td>
                    <td>
                        @if (item.IsActive)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inactive</span>
                        }
                    </td>
                    <td>
                        <a class="text-decoration-none" href="@Url.Action("Update", new { Id = item.Id })">
                            <i class="fa fa-edit me-1"></i>Edit
                        </a>
                        <span class="mx-1">|</span>
                        <a class="text-decoration-none text-danger" href="@Url.Action("Delete", new { Id = item.Id })"
                           onclick="return confirm('Are you sure you want to delete this pin code?');">
                            <i class="fa fa-trash me-1"></i>Delete
                        </a>
                    </td>
                </tr>
            }
        }
        </tbody>
    </table>
</div>
