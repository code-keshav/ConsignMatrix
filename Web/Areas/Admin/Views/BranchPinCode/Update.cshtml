@model Web.Areas.Admin.ViewModels.BranchPinCodeVm

@{
    ViewData["Title"] = "Update Pin Code";
    Layout = "_Layout";
}

<form method="post" asp-action="Update" asp-controller="BranchPinCode" asp-area="Admin">
    <input type="hidden" asp-for="Id"/>
    <input type="hidden" asp-for="BranchId"/>
    <div class="card col-6">
        <h3 class="card-header card-title">Update Pin Code</h3>
        <div class="card-body">
            <div class="d-flex flex-column gap-2">
                <div class="field">
                    <div class="form-group">
                        <label class="form-label">Branch</label>
                        <input type="text" class="form-control" value="@ViewBag.BranchName" readonly disabled/>
                    </div>
                </div>
                <div class="field">
                    <div class="form-group">
                        <label class="form-label required" asp-for="PinCode"></label>
                        <input type="text" asp-for="PinCode" class="form-control" required/>
                        <span asp-validation-for="PinCode" class="text-danger"></span>
                    </div>
                </div>
                <div class="field">
                    <div class="form-group form-check">
                        <input type="checkbox" asp-for="IsActive" class="form-check-input"/>
                        <label class="form-check-label" asp-for="IsActive">Active</label>
                    </div>
                </div>
            </div>
        </div>
        <div class="card-footer">
            <button type="submit" class="btn btn-primary">Update</button>
            <a asp-action="Report" class="btn btn-ghost-muted">Discard</a>
        </div>
    </div>
</form>
