@model Web.Areas.Admin.ViewModels.VehicleIndexVm

@{
    ViewData["Title"] = "Vehicles";
    Layout = "_Layout";
}

<div class="">
    <div class="mt-2">
        <div class="d-flex justify-content-between align-items-end mb-3">
            <span class="header_text">Vehicles</span>
            <div class="d-flex gap-2">
                <a asp-area="Admin" asp-controller="Vehicle" asp-action="Create" class="btn btn-primary btn-sm">
                    Create
                </a>
            </div>
        </div>

        <!-- Filter Section -->
        <div class="card mb-3">
            <div class="card-header">
                <h6 class="mb-0">Filter Vehicles</h6>
            </div>
            <div class="card-body">
                <form asp-area="Admin" asp-controller="Vehicle" asp-action="Index" method="get">
                    <div class="row g-3">
                        <div class="col-md-3">
                            <label asp-for="SearchTerm" class="form-label">Search</label>
                            <input asp-for="SearchTerm" class="form-control" placeholder="Vehicle Number"/>
                        </div>

                        @if (Model.IsMainBranchUser)
                        {
                            <div class="col-md-2">
                                <label asp-for="BranchId" class="form-label">Branch</label>
                                <select asp-for="BranchId" class="form-control select2" asp-items="@Model.BranchSelectList">
                                    <option value="">All Branches</option>
                                </select>
                            </div>
                        }

                        <div class="col-md-2">
                            <label asp-for="VehicleType" class="form-label">Type</label>
                            <select asp-for="VehicleType" class="form-control" asp-items="@Model.VehicleTypeSelectList">
                                <option value="">All Types</option>
                            </select>
                        </div>

                        <div class="col-md-2">
                            <label asp-for="VehicleStatus" class="form-label">Status</label>
                            <select asp-for="VehicleStatus" class="form-control" asp-items="@Model.VehicleStatusSelectList">
                                <option value="">All Statuses</option>
                            </select>
                        </div>

                        <div class="col-md-3 d-flex align-items-end">
                            <button type="submit" class="btn btn-primary me-2">
                                <i class="fa fa-search"></i> Search
                            </button>
                            <a asp-area="Admin" asp-controller="Vehicle" asp-action="Index" class="btn btn-secondary">
                                <i class="fa fa-redo"></i> Reset
                            </a>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <!-- Results Summary -->
        <div class="mb-2">
            <p class="text-muted">
                Showing @((Model.CurrentPage - 1) * Model.PageSize + 1) to @Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalCount) of @Model.TotalCount vehicles
            </p>
        </div>
    </div>

    <!-- Vehicles Table -->
    <div class="table-responsive">
        <table class="table table_bold table-bordered table-hover" id="datatable">
            <thead class="table-light">
            <tr>
                <th>SN</th>
                <th>Vehicle Number</th>
                <th>Type</th>
                <th>Branch</th>
                <th>Weight Cap. (kg)</th>
                <th>Volume Cap. (m³)</th>
                <th>Status</th>
                <th>Insurance Expiry</th>
                <th>Action</th>
            </tr>
            </thead>
            <tbody>
            @if (Model.Vehicles.Any())
            {
                var serialNumber = (Model.CurrentPage - 1) * Model.PageSize;
                foreach (var item in Model.Vehicles)
                {
                    serialNumber++;
                    var insuranceDaysLeft = (item.InsuranceExpiry - DateTime.UtcNow).TotalDays;
                    <tr>
                        <td>@serialNumber</td>
                        <td>@item.VehicleNumber</td>
                        <td>
                            @switch (item.VehicleType)
                            {
                                case Base.Enum.VehicleType.Bike:
                                    <span class="badge bg-info">Bike</span>
                                    break;
                                case Base.Enum.VehicleType.Van:
                                    <span class="badge bg-primary">Van</span>
                                    break;
                                case Base.Enum.VehicleType.Truck:
                                    <span class="badge bg-warning">Truck</span>
                                    break;
                                case Base.Enum.VehicleType.Container:
                                    <span class="badge bg-secondary">Container</span>
                                    break;
                            }
                        </td>
                        <td>@item.BranchName</td>
                        <td>@item.MaxWeightCapacity</td>
                        <td>@item.MaxVolumeCapacity</td>
                        <td>
                            @switch (item.VehicleStatus)
                            {
                                case Base.Enum.VehicleStatus.Available:
                                    <span class="badge bg-success">Available</span>
                                    break;
                                case Base.Enum.VehicleStatus.OnTrip:
                                    <span class="badge bg-primary">On Trip</span>
                                    break;
                                case Base.Enum.VehicleStatus.Maintenance:
                                    <span class="badge bg-warning">Maintenance</span>
                                    break;
                                case Base.Enum.VehicleStatus.Inactive:
                                    <span class="badge bg-secondary">Inactive</span>
                                    break;
                            }
                        </td>
                        <td>
                            @if (insuranceDaysLeft <= 0)
                            {
                                <span class="badge bg-danger">@item.InsuranceExpiry.ToString("yyyy-MM-dd") (Expired)</span>
                            }
                            else if (insuranceDaysLeft <= 30)
                            {
                                <span class="badge bg-warning">@item.InsuranceExpiry.ToString("yyyy-MM-dd")</span>
                            }
                            else
                            {
                                <span>@item.InsuranceExpiry.ToString("yyyy-MM-dd")</span>
                            }
                        </td>
                        <td>
                            <a class="btn btn-sm btn-info" asp-action="Update" asp-route-id="@item.Id">Edit</a>
                            <a class="btn btn-sm btn-success" asp-controller="VehicleAssignment" asp-action="Create" asp-route-vehicleId="@item.Id">Assign</a>
                            <a class="btn btn-sm btn-danger req-confirm" asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="9" class="text-center">No vehicles found</td>
                </tr>
            }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <nav aria-label="Page navigation">
            <ul class="pagination justify-content-center">
                <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                    <a class="page-link" href="?page=@(Model.CurrentPage - 1)&searchTerm=@Model.SearchTerm&branchId=@Model.BranchId&vehicleType=@Model.VehicleType&vehicleStatus=@Model.VehicleStatus">Previous</a>
                </li>

                @for (var i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                        <a class="page-link" href="?page=@i&searchTerm=@Model.SearchTerm&branchId=@Model.BranchId&vehicleType=@Model.VehicleType&vehicleStatus=@Model.VehicleStatus">@i</a>
                    </li>
                }

                <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" href="?page=@(Model.CurrentPage + 1)&searchTerm=@Model.SearchTerm&branchId=@Model.BranchId&vehicleType=@Model.VehicleType&vehicleStatus=@Model.VehicleStatus">Next</a>
                </li>
            </ul>
        </nav>
    }
</div>

@section Scripts{
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            @if (Model.IsMainBranchUser)
            {
                <text>
                    $('.select2').select2({
                        placeholder: "Select Branch",
                        allowClear: true,
                        width: '100%'
                    });
                </text>
            }
        });
    </script>
}
