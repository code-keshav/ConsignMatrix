@model Web.Areas.Admin.ViewModels.VehicleEditVm

@{
    ViewData["Title"] = "Update Vehicle";
    Layout = "_Layout";
}

<div>
    <form method="post" asp-action="Update" asp-controller="Vehicle" asp-area="Admin">
        <div class="card col-10">
            <h3 class="card-header">Update Vehicle</h3>
            <div class="card-body">
                <div class="row w-full">
                    <div class="field" hidden>
                        <input type="hidden" asp-for="Id"/>
                    </div>

                    <!-- Left Column -->
                    <div class="col-6 d-flex flex-column gap-2">
                        <div class="field">
                            <div class="form-group">
                                <label class="form-label required" asp-for="VehicleNumber"></label>
                                <input type="text" asp-for="VehicleNumber" class="form-control" readonly/>
                                <span asp-validation-for="VehicleNumber" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="field">
                            <div class="form-group">
                                <label class="form-label" asp-for="CurrentBranchId"></label>
                                <select asp-for="CurrentBranchId" class="form-control" asp-items="@Model.BranchOptions">
                                    <option value="">-- Select Branch --</option>
                                </select>
                                <span asp-validation-for="CurrentBranchId" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="field">
                            <div class="form-group">
                                <label class="form-label required" asp-for="VehicleType"></label>
                                <select asp-for="VehicleType" class="form-control"
                                        asp-items="Html.GetEnumSelectList<Base.Enum.VehicleType>()" required>
                                </select>
                                <span asp-validation-for="VehicleType" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="field">
                            <div class="form-group">
                                <label class="form-label required" asp-for="OwnershipType"></label>
                                <select asp-for="OwnershipType" class="form-control"
                                        asp-items="Html.GetEnumSelectList<Base.Enum.VehicleOwnershipType>()" required>
                                </select>
                                <span asp-validation-for="OwnershipType" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="field">
                            <div class="form-group">
                                <label class="form-label required" asp-for="FuelType"></label>
                                <select asp-for="FuelType" class="form-control"
                                        asp-items="Html.GetEnumSelectList<Base.Enum.FuelType>()" required>
                                </select>
                                <span asp-validation-for="FuelType" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="field">
                            <div class="form-group">
                                <label class="form-label required" asp-for="VehicleStatus"></label>
                                <select asp-for="VehicleStatus" class="form-control"
                                        asp-items="Html.GetEnumSelectList<Base.Enum.VehicleStatus>()" required>
                                </select>
                                <span asp-validation-for="VehicleStatus" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <!-- Right Column -->
                    <div class="col-6 d-flex flex-column gap-2">
                        <div class="field">
                            <div class="form-group">
                                <label class="form-label required" asp-for="MaxWeightCapacity"></label>
                                <input type="number" step="0.01" asp-for="MaxWeightCapacity" class="form-control" required/>
                                <span asp-validation-for="MaxWeightCapacity" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="field">
                            <div class="form-group">
                                <label class="form-label required" asp-for="MaxVolumeCapacity"></label>
                                <input type="number" step="0.01" asp-for="MaxVolumeCapacity" class="form-control" required/>
                                <span asp-validation-for="MaxVolumeCapacity" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="field">
                            <div class="form-group">
                                <div class="form-check mt-3">
                                    <input type="checkbox" asp-for="SupportsFragile" class="form-check-input"/>
                                    <label class="form-check-label" asp-for="SupportsFragile"></label>
                                </div>
                            </div>
                        </div>
                        <div class="field">
                            <div class="form-group">
                                <div class="form-check">
                                    <input type="checkbox" asp-for="HasColdStorage" class="form-check-input"/>
                                    <label class="form-check-label" asp-for="HasColdStorage"></label>
                                </div>
                            </div>
                        </div>
                        <div class="field">
                            <div class="form-group">
                                <label class="form-label required" asp-for="InsuranceExpiry"></label>
                                <input type="date" asp-for="InsuranceExpiry" class="form-control" required/>
                                <span asp-validation-for="InsuranceExpiry" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="field">
                            <div class="form-group">
                                <label class="form-label" asp-for="LastServiceDate"></label>
                                <input type="date" asp-for="LastServiceDate" class="form-control"/>
                                <span asp-validation-for="LastServiceDate" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="card-footer">
                <button type="submit" class="btn btn-primary">Update</button>
                <a asp-action="Index" class="btn btn-ghost-muted">Discard</a>
            </div>
        </div>
    </form>
</div>
