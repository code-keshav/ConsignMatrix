@using Base.Enum.Consignment
@model Web.Areas.Consignment.ViewModels.Consignment.ConsignmentFilterVm

@{
    ViewBag.Title = "Consignments";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <span class="fw-semibold mb-0">Consignments</span>
    <a asp-area="Consignment" asp-controller="Consignment" asp-action="Create" class="btn btn-primary btn-sm">
        <i class="fa fa-plus"></i> New Consignment
    </a>
</div>

<div class="card mb-3">
    <div class="card-body">
        <form asp-area="Consignment" asp-controller="Consignment" asp-action="Index" method="get">
            <div class="filter-container">
                <div class="filter-col">
                    <label asp-for="TrackingNumber" class="form-label">Tracking Number</label>
                    <input asp-for="TrackingNumber" class="form-control" placeholder="TRK..."/>
                </div>
                <div class="filter-col">
                    <label class="form-label">Service Type</label>
                    <select asp-for="ServiceType" class="form-control"
                            asp-items="Html.GetEnumSelectList<ServiceType>()">
                        <option value="">-- All --</option>
                    </select>
                </div>
                <div class="filter-col">
                    <label class="form-label">Payment Mode</label>
                    <select asp-for="PaymentMode" class="form-control"
                            asp-items="Html.GetEnumSelectList<PaymentMode>()">
                        <option value="">-- All --</option>
                    </select>
                </div>
                <div class="filter-col">
                    <label asp-for="DateFrom" class="form-label">Date From</label>
                    <input asp-for="DateFrom" type="date" class="form-control"/>
                </div>
                <div class="filter-col">
                    <label asp-for="DateTo" class="form-label">Date To</label>
                    <input asp-for="DateTo" type="date" class="form-control"/>
                </div>
                <div class="filter-btn">
                    <div class="d-flex align-items-end">
                        <button type="submit" class="btn btn-primary btn-sm me-2">
                            <i class="fa fa-search"></i> Search
                        </button>
                        <a asp-area="Consignment" asp-controller="Consignment" asp-action="Index" class="btn btn-secondary btn-sm">
                            <i class="fa fa-redo"></i> Reset
                        </a>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="table-responsive">
    <table class="table table_bold table-bordered table-hover">
        <thead class="table-light">
        <tr>
            <th>SN</th>
            <th>Tracking #</th>
            <th>Sender</th>
            <th>Receiver</th>
            <th>Service</th>
            <th>Payment</th>
            <th>Packages</th>
            <th>Weight (kg)</th>
            <th>Status</th>
            <th>Date</th>
            <th>Action</th>
        </tr>
        </thead>
        <tbody>
        @if (Model.Consignments.Any())
        {
            var serialNumber = (Model.CurrentPage - 1) * Model.PageSize;
            foreach (var item in Model.Consignments)
            {
                serialNumber++;
                <tr>
                    <td>@serialNumber</td>
                    <td><strong>@item.TrackingNumber</strong></td>
                    <td>@item.SenderName</td>
                    <td>@item.ReceiverName</td>
                    <td>@item.ServiceType.ToString()</td>
                    <td>@item.PaymentMode.ToString()</td>
                    <td>@item.PackageCount</td>
                    <td>@item.ChargeableWeight.ToString("F2")</td>
                    <td>
                        @if (item.LatestStatus != null)
                        {
                            <span class="badge bg-info">@item.LatestStatus</span>
                        }
                    </td>
                    <td>@item.RecDate.ToString("yyyy-MM-dd")</td>
                    <td>
                        <a class="text-secondary text-decoration-none" asp-action="Detail" asp-route-id="@item.Id">Detail</a>
                        |
                        <a class="text-primary text-decoration-none" asp-action="Update" asp-route-id="@item.Id">Edit</a>
                        |
                        <a class="text-danger text-decoration-none req-confirm" asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                    </td>
                </tr>
            }
        }
        </tbody>
    </table>
</div>
