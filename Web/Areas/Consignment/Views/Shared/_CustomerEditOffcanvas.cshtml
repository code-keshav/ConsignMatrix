<div id="customer-edit-offcanvas-app">
    <div class="offcanvas offcanvas-end" tabindex="-1" ref="offcanvasEl" style="width: 450px;">
        <div class="offcanvas-header">
            <h5 class="offcanvas-title">{{ title }}</h5>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
        </div>
        <div class="offcanvas-body">
            <div v-if="loading" class="text-center py-4">
                <i class="fa fa-spinner fa-spin fa-2x"></i>
                <p class="mt-2 text-muted">Loading...</p>
            </div>

            <!-- Customer Edit -->
            <div v-if="!loading && mode === 'customer'">
                <div class="mb-3">
                    <label class="form-label required">Name</label>
                    <input type="text" class="form-control" v-model="customerForm.name" />
                </div>
                <div class="mb-3">
                    <label class="form-label required">Phone</label>
                    <input type="text" class="form-control" v-model="customerForm.phoneNo" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Secondary Phone</label>
                    <input type="text" class="form-control" v-model="customerForm.secondaryPhoneNo" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Email</label>
                    <input type="text" class="form-control" v-model="customerForm.email" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Customer Type</label>
                    <select class="form-control" v-model="customerForm.customerType">
                        <option :value="1">Individual</option>
                        <option :value="2">Business</option>
                    </select>
                </div>
            </div>

            <!-- Address Edit -->
            <div v-if="!loading && mode === 'address'">
                <div class="mb-3">
                    <label class="form-label">Address Type</label>
                    <select class="form-control" v-model="addressForm.addressType">
                        <option :value="1">Home</option>
                        <option :value="2">Office</option>
                        <option :value="3">Warehouse</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label required">Address Line 1</label>
                    <input type="text" class="form-control" v-model="addressForm.addressLine1" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Address Line 2</label>
                    <input type="text" class="form-control" v-model="addressForm.addressLine2" />
                </div>
                <div class="mb-3">
                    <label class="form-label required">City</label>
                    <input type="text" class="form-control" v-model="addressForm.city" />
                </div>
                <div class="mb-3">
                    <label class="form-label required">State</label>
                    <input type="text" class="form-control" v-model="addressForm.state" />
                </div>
                <div class="mb-3">
                    <label class="form-label required">Pin Code</label>
                    <input type="text" class="form-control" v-model="addressForm.pinCode" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Landmark</label>
                    <input type="text" class="form-control" v-model="addressForm.landmark" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Contact No</label>
                    <input type="text" class="form-control" v-model="addressForm.contactNo" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Latitude</label>
                    <input type="text" class="form-control" v-model="addressForm.latitude" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Longitude</label>
                    <input type="text" class="form-control" v-model="addressForm.longitude" />
                </div>
            </div>

            <div v-if="!loading" class="mt-3">
                <button class="btn btn-primary" v-on:click="save" :disabled="saving">
                    <span v-if="saving"><i class="fa fa-spinner fa-spin"></i> Saving...</span>
                    <span v-else>Save</span>
                </button>
                <button class="btn btn-outline-secondary ms-2" data-bs-dismiss="offcanvas">Cancel</button>
            </div>
        </div>
    </div>
</div>

<script>
(function () {
    const { createApp, ref, nextTick } = Vue;

    let bsOffcanvas = null;
    let onSuccessCallback = null;

    const app = createApp({
        setup() {
            const offcanvasEl = ref(null);
            const mode = ref('');
            const title = ref('');
            const loading = ref(false);
            const saving = ref(false);

            const customerForm = ref({ id: 0, name: '', phoneNo: '', secondaryPhoneNo: '', email: '', customerType: 1 });
            const addressForm = ref({ addressId: 0, customerId: 0, addressType: 1, addressLine1: '', addressLine2: '', city: '', state: '', pinCode: '', landmark: '', contactNo: '', latitude: '', longitude: '' });

            const openOffcanvas = () => {
                nextTick(() => {
                    if (!bsOffcanvas && offcanvasEl.value) {
                        bsOffcanvas = new bootstrap.Offcanvas(offcanvasEl.value);
                    }
                    if (bsOffcanvas) bsOffcanvas.show();
                });
            };

            const closeOffcanvas = () => {
                if (bsOffcanvas) bsOffcanvas.hide();
            };

            const openCustomerEdit = async (customerId, onSuccess) => {
                mode.value = 'customer';
                title.value = 'Edit Customer';
                loading.value = true;
                onSuccessCallback = onSuccess || null;
                openOffcanvas();
                try {
                    const res = await fetch(`/Consignment/Customer/GetCustomer?id=${customerId}`);
                    const data = await res.json();
                    if (data.error) throw new Error(data.error);
                    customerForm.value = {
                        id: data.id,
                        name: data.name,
                        phoneNo: data.phoneNo,
                        secondaryPhoneNo: data.secondaryPhoneNo || '',
                        email: data.email || '',
                        customerType: data.customerType,
                    };
                } catch (e) {
                    notify.error(e.message || 'Failed to load customer.');
                    closeOffcanvas();
                } finally {
                    loading.value = false;
                }
            };

            const openAddressEdit = async (addressId, onSuccess) => {
                mode.value = 'address';
                title.value = 'Edit Address';
                loading.value = true;
                onSuccessCallback = onSuccess || null;
                openOffcanvas();
                try {
                    const res = await fetch(`/Consignment/CustomerAddress/GetAddress?id=${addressId}`);
                    const data = await res.json();
                    if (data.error) throw new Error(data.error);
                    addressForm.value = {
                        addressId: data.id,
                        customerId: data.customerId,
                        addressType: data.addressType,
                        addressLine1: data.addressLine1 || '',
                        addressLine2: data.addressLine2 || '',
                        city: data.city || '',
                        state: data.state || '',
                        pinCode: data.pinCode || '',
                        landmark: data.landmark || '',
                        contactNo: data.contactNo || '',
                        latitude: data.latitude || '',
                        longitude: data.longitude || '',
                    };
                } catch (e) {
                    notify.error(e.message || 'Failed to load address.');
                    closeOffcanvas();
                } finally {
                    loading.value = false;
                }
            };

            const save = async () => {
                saving.value = true;
                try {
                    if (mode.value === 'customer') {
                        if (!customerForm.value.name || !customerForm.value.phoneNo) {
                            notify.error('Name and Phone are required.', 'Validation Error');
                            return;
                        }
                        const res = await fetch('/Consignment/Customer/UpdateAjax', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify(customerForm.value),
                        });
                        const result = await res.json();
                        if (!result.success) throw new Error(result.message);
                        closeOffcanvas();
                        notify.success(result.message, 'Updated');
                        if (onSuccessCallback) onSuccessCallback(result.data);
                    } else if (mode.value === 'address') {
                        if (!addressForm.value.addressLine1 || !addressForm.value.city || !addressForm.value.state || !addressForm.value.pinCode) {
                            notify.error('Address Line 1, City, State and Pin Code are required.', 'Validation Error');
                            return;
                        }
                        const res = await fetch('/Consignment/CustomerAddress/UpdateAjax', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify(addressForm.value),
                        });
                        const result = await res.json();
                        if (!result.success) throw new Error(result.message);
                        closeOffcanvas();
                        notify.success(result.message, 'Updated');
                        if (onSuccessCallback) onSuccessCallback(result.data);
                    }
                } catch (e) {
                    notify.error(e.message || 'Failed to save.');
                } finally {
                    saving.value = false;
                }
            };

            // Expose globally
            window.customerEditOffcanvas = { openCustomerEdit, openAddressEdit };

            return { offcanvasEl, mode, title, loading, saving, customerForm, addressForm, save };
        }
    });
    app.mount('#customer-edit-offcanvas-app');
})();
</script>
