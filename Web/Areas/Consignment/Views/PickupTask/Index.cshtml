@using Base.Enum.Consignment
@model Web.Areas.Consignment.ViewModels.Pickup.PickupIndexVm

@{
    ViewData["Title"] = "Pickup Operations";
}

<div id="pickup-app">
    <!-- Filter Bar -->
    <div class="card shadow-sm mb-3">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Pickup Operations</h5>
            <a href="/Consignment/PickupTask/Create" class="btn btn-sm btn-primary">
                <i class="fa fa-plus"></i> Schedule Pickup
            </a>
        </div>
        <div class="card-body">
            <div class="mb-2 filter-container">
                <div class="filter-col form-group">
                    <label class="form-label">Date</label>
                    <input type="date" class="form-control" v-model="filterDate" v-on:change="loadTasks"/>
                </div>
                <div class="filter-col form-group">
                    <label class="form-label">Status</label>
                    <select class="form-control" v-model="filterStatus" v-on:change="loadTasks">
                        <option value="">All</option>
                        <option value="1">Pending</option>
                        <option value="2">Assigned</option>
                        <option value="3">In Progress</option>
                        <option value="4">Completed</option>
                        <option value="5">Failed</option>
                        <option value="6">Cancelled</option>
                    </select>
                </div>
                <div class="filter-col form-group">
                    <label class="form-label">Slot</label>
                    <select class="form-control" v-model="filterSlot" v-on:change="loadTasks">
                        <option value="">All</option>
                        <option value="1">Morning</option>
                        <option value="2">Afternoon</option>
                        <option value="3">Evening</option>
                    </select>
                </div>
                <div class="filter-col form-group">
                    <label class="form-label">Driver</label>
                    <select class="form-control" v-model="filterDriverId" v-on:change="loadTasks">
                        <option value="">All</option>
                        <option v-for="d in drivers" :value="d.id">{{ d.name }} ({{ d.employeeCode }})</option>
                    </select>
                </div>
            </div>
        </div>
    </div>

    <!-- Summary Cards -->
    <div class="row mb-3">
        <div class="col-md-2">
            <div class="card text-center shadow-sm">
                <div class="card-body py-2">
                    <h5 class="mb-0 text-warning">{{ summary.pending }}</h5>
                    <small class="text-muted">Pending</small>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card text-center shadow-sm">
                <div class="card-body py-2">
                    <h5 class="mb-0 text-info">{{ summary.assigned }}</h5>
                    <small class="text-muted">Assigned</small>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card text-center shadow-sm">
                <div class="card-body py-2">
                    <h5 class="mb-0 text-primary">{{ summary.inProgress }}</h5>
                    <small class="text-muted">In Progress</small>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card text-center shadow-sm">
                <div class="card-body py-2">
                    <h5 class="mb-0 text-success">{{ summary.completed }}</h5>
                    <small class="text-muted">Completed</small>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card text-center shadow-sm">
                <div class="card-body py-2">
                    <h5 class="mb-0 text-danger">{{ summary.failed }}</h5>
                    <small class="text-muted">Failed</small>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card text-center shadow-sm">
                <div class="card-body py-2">
                    <h5 class="mb-0">{{ summary.total }}</h5>
                    <small class="text-muted">Total</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Bulk Assign Bar -->
    <div v-if="selectedIds.length > 0" class="alert alert-info d-flex align-items-center justify-content-between mb-3">
        <span><strong>{{ selectedIds.length }}</strong> task(s) selected</span>
        <div class="d-flex gap-2 align-items-center">
            <select class="form-control form-control-sm" v-model="bulkDriverId" style="width:200px">
                <option value="">Select Driver</option>
                <option v-for="d in drivers" :value="d.id">{{ d.name }}</option>
            </select>
            <select class="form-control form-control-sm" v-model="bulkVehicleId" style="width:200px">
                <option value="">Select Vehicle</option>
                <option v-for="v in vehicles" :value="v.id">{{ v.vehicleNumber }} ({{ v.vehicleType }})</option>
            </select>
            <button class="btn btn-sm btn-primary" v-on:click="bulkAssign" :disabled="!bulkDriverId || !bulkVehicleId">
                <i class="fa fa-user-check"></i> Assign Selected
            </button>
            <button class="btn btn-sm btn-secondary" v-on:click="selectedIds = []">Clear</button>
        </div>
    </div>

    <!-- Data Table -->
    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped mb-0">
                    <thead>
                        <tr>
                            <th style="width:30px">
                                <input type="checkbox" v-on:change="toggleSelectAll" :checked="isAllPendingSelected"/>
                            </th>
                            <th>Tracking #</th>
                            <th>Sender</th>
                            <th>Pickup Address</th>
                            <th>Slot</th>
                            <th>Status</th>
                            <th>Driver</th>
                            <th>Vehicle</th>
                            <th>Wt (kg)</th>
                            <th>Pkgs</th>
                            <th>Attempts</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr v-if="loading">
                            <td colspan="12" class="text-center py-4">
                                <div class="spinner-border spinner-border-sm" role="status"></div> Loading...
                            </td>
                        </tr>
                        <tr v-if="!loading && tasks.length === 0">
                            <td colspan="12" class="text-center py-4 text-muted">No pickup tasks found for the selected filters.</td>
                        </tr>
                        <tr v-for="t in tasks" :key="t.id">
                            <td>
                                <input type="checkbox" v-if="t.taskStatusValue === 1" :value="t.id"
                                       v-model="selectedIds"/>
                            </td>
                            <td>
                                <a :href="'/Consignment/Consignment/Detail/' + t.consignmentId">{{ t.trackingNumber }}</a>
                            </td>
                            <td>{{ t.senderName }}</td>
                            <td class="text-truncate" style="max-width:200px" :title="t.pickupAddress">{{ t.pickupAddress }}</td>
                            <td><span class="badge bg-secondary">{{ t.pickupSlot }}</span></td>
                            <td>
                                <span :class="statusBadge(t.taskStatusValue)">{{ t.taskStatus }}</span>
                            </td>
                            <td>{{ t.driverName || '-' }}</td>
                            <td>{{ t.vehicleNumber || '-' }}</td>
                            <td>{{ t.consignmentWeight }}</td>
                            <td>{{ t.packageCount }}</td>
                            <td>{{ t.attemptCount }}</td>
                            <td>
                                <div class="btn-group btn-group-sm">
                                    <a :href="'/Consignment/PickupTask/Detail/' + t.id" class="btn btn-outline-info btn-sm" title="Detail">
                                        <i class="fa fa-eye"></i>
                                    </a>
                                    <button v-if="t.taskStatusValue === 1" class="btn btn-outline-primary btn-sm"
                                            v-on:click="openAssignModal(t)" title="Assign">
                                        <i class="fa fa-user-plus"></i>
                                    </button>
                                    <button v-if="t.taskStatusValue === 2" class="btn btn-outline-info btn-sm"
                                            v-on:click="startPickup(t.id)" title="Start">
                                        <i class="fa fa-play"></i>
                                    </button>
                                    <button v-if="t.taskStatusValue === 2 || t.taskStatusValue === 3"
                                            class="btn btn-outline-success btn-sm"
                                            v-on:click="openCompleteModal(t)" title="Complete">
                                        <i class="fa fa-check"></i>
                                    </button>
                                    <button v-if="t.taskStatusValue === 2 || t.taskStatusValue === 3"
                                            class="btn btn-outline-danger btn-sm"
                                            v-on:click="openFailModal(t)" title="Fail">
                                        <i class="fa fa-times"></i>
                                    </button>
                                    <button v-if="t.taskStatusValue < 4" class="btn btn-outline-secondary btn-sm"
                                            v-on:click="cancelPickup(t.id)" title="Cancel">
                                        <i class="fa fa-ban"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Assign Modal -->
    <div class="modal fade" id="assignModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Assign Pickup</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted mb-3">Tracking: <strong>{{ assignForm.trackingNumber }}</strong></p>
                    <div class="form-group mb-3">
                        <label class="form-label required">Driver</label>
                        <select class="form-control" v-model="assignForm.driverId">
                            <option value="">-- Select Driver --</option>
                            <option v-for="d in drivers" :value="d.id">{{ d.name }} ({{ d.employeeCode }})</option>
                        </select>
                    </div>
                    <div class="form-group mb-3">
                        <label class="form-label required">Vehicle</label>
                        <select class="form-control" v-model="assignForm.vehicleId">
                            <option value="">-- Select Vehicle --</option>
                            <option v-for="v in vehicles" :value="v.id">{{ v.vehicleNumber }} ({{ v.vehicleType }}) - {{ v.maxWeightCapacity }}kg</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary" v-on:click="submitAssign"
                            :disabled="!assignForm.driverId || !assignForm.vehicleId">Assign</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Complete Modal -->
    <div class="modal fade" id="completeModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Complete Pickup</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted mb-3">Tracking: <strong>{{ completeForm.trackingNumber }}</strong></p>
                    <div class="form-group mb-3">
                        <label class="form-label required">Verified Weight (kg)</label>
                        <input type="number" step="0.001" class="form-control" v-model.number="completeForm.verifiedWeight"/>
                    </div>
                    <div class="form-group mb-3">
                        <label class="form-label">Remarks</label>
                        <textarea class="form-control" rows="2" v-model="completeForm.remarks"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-success" v-on:click="submitComplete"
                            :disabled="!completeForm.verifiedWeight">Complete</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Fail Modal -->
    <div class="modal fade" id="failModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Mark Pickup as Failed</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted mb-3">Tracking: <strong>{{ failForm.trackingNumber }}</strong></p>
                    <div class="form-group mb-3">
                        <label class="form-label required">Failure Reason</label>
                        <select class="form-control" v-model.number="failForm.failReason">
                            <option value="">-- Select Reason --</option>
                            <option value="1">Customer Not Available</option>
                            <option value="2">Address Not Found</option>
                            <option value="3">Package Not Ready</option>
                            <option value="4">Weight Mismatch</option>
                            <option value="5">Access Restricted</option>
                            <option value="6">Weather Conditions</option>
                            <option value="7">Vehicle Breakdown</option>
                            <option value="8">Customer Refused</option>
                            <option value="9">Other</option>
                        </select>
                    </div>
                    <div class="form-group mb-3">
                        <label class="form-label">Remarks</label>
                        <textarea class="form-control" rows="2" v-model="failForm.remarks"></textarea>
                    </div>
                    <div class="form-check mb-3">
                        <input type="checkbox" class="form-check-input" id="rescheduleCheck" v-model="failForm.reschedule"/>
                        <label class="form-check-label" for="rescheduleCheck">Reschedule pickup</label>
                    </div>
                    <div v-if="failForm.reschedule" class="d-flex gap-2">
                        <div class="form-group flex-fill">
                            <label class="form-label">Reschedule Date</label>
                            <input type="date" class="form-control" v-model="failForm.rescheduleDate"/>
                        </div>
                        <div class="form-group flex-fill">
                            <label class="form-label">Reschedule Slot</label>
                            <select class="form-control" v-model.number="failForm.rescheduleSlot">
                                <option value="1">Morning</option>
                                <option value="2">Afternoon</option>
                                <option value="3">Evening</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-danger" v-on:click="submitFail"
                            :disabled="!failForm.failReason">Submit</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/dist/js/vue-prod-3.4.27.min.js"></script>
    <script>
        const { createApp, ref, computed, onMounted } = Vue;
        createApp({
            setup() {
                const branchId = @Model.CurrentBranchId;
                const today = new Date().toISOString().split('T')[0];

                const filterDate = ref(today);
                const filterStatus = ref('');
                const filterSlot = ref('');
                const filterDriverId = ref('');
                const loading = ref(false);

                const tasks = ref([]);
                const drivers = ref([]);
                const vehicles = ref([]);
                const selectedIds = ref([]);
                const bulkDriverId = ref('');
                const bulkVehicleId = ref('');

                const summary = ref({ pending: 0, assigned: 0, inProgress: 0, completed: 0, failed: 0, total: 0 });

                // Assign form
                const assignForm = ref({ pickupTaskId: 0, trackingNumber: '', driverId: '', vehicleId: '' });
                // Complete form
                const completeForm = ref({ pickupTaskId: 0, trackingNumber: '', verifiedWeight: null, remarks: '' });
                // Fail form
                const failForm = ref({
                    pickupTaskId: 0, trackingNumber: '', failReason: '',
                    remarks: '', reschedule: true, rescheduleDate: '', rescheduleSlot: 1
                });

                const isAllPendingSelected = computed(() => {
                    const pending = tasks.value.filter(t => t.taskStatusValue === 1);
                    return pending.length > 0 && pending.every(t => selectedIds.value.includes(t.id));
                });

                function statusBadge(statusValue) {
                    const map = {
                        1: 'badge bg-warning',
                        2: 'badge bg-info',
                        3: 'badge bg-primary',
                        4: 'badge bg-success',
                        5: 'badge bg-danger',
                        6: 'badge bg-secondary',
                    };
                    return map[statusValue] || 'badge bg-secondary';
                }

                async function loadTasks() {
                    loading.value = true;
                    try {
                        const params = new URLSearchParams();
                        if (filterDate.value) params.set('date', filterDate.value);
                        if (filterStatus.value) params.set('status', filterStatus.value);
                        if (filterSlot.value) params.set('slot', filterSlot.value);
                        if (filterDriverId.value) params.set('driverId', filterDriverId.value);

                        const res = await fetch(`/Consignment/PickupTask/GetPickupTasks?${params}`);
                        const data = await res.json();
                        if (data.success) {
                            tasks.value = data.tasks;
                            summary.value = data.summary;
                        } else {
                            notify.error(data.message || 'Failed to load tasks');
                        }
                    } catch (e) {
                        notify.error(e.message);
                    }
                    loading.value = false;
                }

                async function loadDriversAndVehicles() {
                    try {
                        const [dRes, vRes] = await Promise.all([
                            fetch(`/Consignment/PickupTask/GetAvailableDrivers?branchId=${branchId}`),
                            fetch(`/Consignment/PickupTask/GetAvailableVehicles?branchId=${branchId}`)
                        ]);
                        drivers.value = await dRes.json();
                        vehicles.value = await vRes.json();
                    } catch (e) {
                        console.error('Failed to load drivers/vehicles', e);
                    }
                }

                function toggleSelectAll(e) {
                    const pending = tasks.value.filter(t => t.taskStatusValue === 1);
                    if (e.target.checked) {
                        selectedIds.value = pending.map(t => t.id);
                    } else {
                        selectedIds.value = [];
                    }
                }

                // Assign
                function openAssignModal(task) {
                    assignForm.value = { pickupTaskId: task.id, trackingNumber: task.trackingNumber, driverId: '', vehicleId: '' };
                    new bootstrap.Modal(document.getElementById('assignModal')).show();
                }

                async function submitAssign() {
                    try {
                        const res = await fetch('/Consignment/PickupTask/Assign', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify(assignForm.value),
                        });
                        const data = await res.json();
                        if (data.success) {
                            notify.success(data.message);
                            bootstrap.Modal.getInstance(document.getElementById('assignModal')).hide();
                            await loadTasks();
                        } else {
                            notify.error(data.message);
                        }
                    } catch (e) {
                        notify.error(e.message);
                    }
                }

                async function bulkAssign() {
                    if (!bulkDriverId.value || !bulkVehicleId.value) return;
                    try {
                        const res = await fetch('/Consignment/PickupTask/BulkAssign', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({
                                pickupTaskIds: selectedIds.value,
                                driverId: bulkDriverId.value,
                                vehicleId: bulkVehicleId.value,
                            }),
                        });
                        const data = await res.json();
                        if (data.success) {
                            notify.success(data.message);
                            selectedIds.value = [];
                            bulkDriverId.value = '';
                            bulkVehicleId.value = '';
                            await loadTasks();
                        } else {
                            notify.error(data.message);
                        }
                    } catch (e) {
                        notify.error(e.message);
                    }
                }

                // Start
                async function startPickup(id) {
                    notify.confirm('Start this pickup?', async () => {
                        try {
                            const res = await fetch(`/Consignment/PickupTask/MarkInProgress?id=${id}`, { method: 'POST' });
                            const data = await res.json();
                            if (data.success) {
                                notify.success(data.message);
                                await loadTasks();
                            } else {
                                notify.error(data.message);
                            }
                        } catch (e) {
                            notify.error(e.message);
                        }
                    });
                }

                // Complete
                function openCompleteModal(task) {
                    completeForm.value = {
                        pickupTaskId: task.id,
                        trackingNumber: task.trackingNumber,
                        verifiedWeight: task.consignmentWeight,
                        remarks: ''
                    };
                    new bootstrap.Modal(document.getElementById('completeModal')).show();
                }

                async function submitComplete() {
                    try {
                        const res = await fetch('/Consignment/PickupTask/Complete', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify(completeForm.value),
                        });
                        const data = await res.json();
                        if (data.success) {
                            notify.success(data.message);
                            bootstrap.Modal.getInstance(document.getElementById('completeModal')).hide();
                            await loadTasks();
                        } else {
                            notify.error(data.message);
                        }
                    } catch (e) {
                        notify.error(e.message);
                    }
                }

                // Fail
                function openFailModal(task) {
                    const tomorrow = new Date();
                    tomorrow.setDate(tomorrow.getDate() + 1);
                    failForm.value = {
                        pickupTaskId: task.id,
                        trackingNumber: task.trackingNumber,
                        failReason: '',
                        remarks: '',
                        reschedule: true,
                        rescheduleDate: tomorrow.toISOString().split('T')[0],
                        rescheduleSlot: task.pickupSlotValue || 1,
                    };
                    new bootstrap.Modal(document.getElementById('failModal')).show();
                }

                async function submitFail() {
                    try {
                        const res = await fetch('/Consignment/PickupTask/Fail', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify(failForm.value),
                        });
                        const data = await res.json();
                        if (data.success) {
                            notify.success(data.message);
                            bootstrap.Modal.getInstance(document.getElementById('failModal')).hide();
                            await loadTasks();
                        } else {
                            notify.error(data.message);
                        }
                    } catch (e) {
                        notify.error(e.message);
                    }
                }

                // Cancel
                function cancelPickup(id) {
                    notify.confirm('Cancel this pickup task?', async () => {
                        try {
                            const res = await fetch(`/Consignment/PickupTask/Cancel?id=${id}`, { method: 'POST' });
                            const data = await res.json();
                            if (data.success) {
                                notify.success(data.message);
                                await loadTasks();
                            } else {
                                notify.error(data.message);
                            }
                        } catch (e) {
                            notify.error(e.message);
                        }
                    });
                }

                onMounted(async () => {
                    await loadDriversAndVehicles();
                    await loadTasks();
                });

                return {
                    filterDate, filterStatus, filterSlot, filterDriverId,
                    loading, tasks, drivers, vehicles, summary,
                    selectedIds, bulkDriverId, bulkVehicleId,
                    isAllPendingSelected,
                    assignForm, completeForm, failForm,
                    statusBadge, loadTasks, toggleSelectAll,
                    openAssignModal, submitAssign, bulkAssign,
                    startPickup,
                    openCompleteModal, submitComplete,
                    openFailModal, submitFail,
                    cancelPickup,
                };
            }
        }).mount('#pickup-app');
    </script>
}
